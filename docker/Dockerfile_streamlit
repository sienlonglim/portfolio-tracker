FROM python:3.11.15-slim

# uv image from Astral
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1


# Install dependencies and add the virtual environment to PATH
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache --group dashboard --no-install-project
ENV PATH="/app/.venv/bin:$PATH"

# Copy the application code into the container
# COPY . /app

# Create a non-root user to run the application
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

# Start the streamlit application on port 8501 and bind to all network interfaces
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
